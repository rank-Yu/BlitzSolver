<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CombatSolverRepositoryRoot)src/Flash/Kernel/**/*.cs" LinkBase="Flash/Kernel" />
    <Compile Include="$(CombatSolverRepositoryRoot)src/Flash/Content/**/*.cs" LinkBase="Flash/Content" />
  </ItemGroup>
</Project>
